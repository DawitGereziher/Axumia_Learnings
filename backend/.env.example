# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ethiolearn?schema=public"

# JWT & Auth
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# Encryption (for OAuth tokens - generate a 32-byte hex string)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# YouTube Video ID Encryption (for secure video storage)
YOUTUBE_ENCRYPTION_SECRET="your-youtube-encryption-secret"
YOUTUBE_ENCRYPTION_SALT="your-youtube-encryption-salt"

# Content Security (for signed URLs and access control)
CONTENT_SIGNATURE_SECRET="your-content-signature-secret"
SIGNED_URL_TTL_MS="3600000"

# Referrer Security (prevent hotlinking)
ALLOWED_REFERRER_DOMAINS="http://localhost:3001,http://localhost:3002"
STRICT_REFERRER_CHECK="false"

# Rate Limiting (prevent abuse)
RATE_LIMIT_MAX_ATTEMPTS="100"
RATE_LIMIT_WINDOW_MS="3600000"
USE_DATABASE_RATE_LIMIT="false"

# Zoom OAuth
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"
ZOOM_REDIRECT_URI="http://localhost:3000/api/session-monitoring/zoom/callback"
ZOOM_WEBHOOK_SECRET="your-zoom-webhook-secret"

# Google Meet OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_MEET_REDIRECT_URI="http://localhost:3000/api/session-monitoring/google/callback"

# Frontend URL (for OAuth redirects)
FRONTEND_URL="http://localhost:3001"

# AWS S3 (for file storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-bucket-name"

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@axumia.com"

# Redis (for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""