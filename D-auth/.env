# ─── D-auth Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ethiolearn

# ── JWT ────────────────────────────────────────────────────────────────────────
# MUST be a long random secret — same value must be set in the NestJS backend
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m

# ── Frontend URL (used in email links and OAuth redirects) ─────────────────────
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── Facebook OAuth ─────────────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# ── Microsoft OAuth ────────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

# ── Apple Sign-In ──────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./certs/AuthKey.p8
APPLE_CALLBACK_URL=http://localhost:3001/auth/apple/callback

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Replace with your actual SMTP provider (SendGrid, Postmark, Gmail, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# ── Server (demo only) ─────────────────────────────────────────────────────────
PORT=3001