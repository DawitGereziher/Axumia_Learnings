# ==========================================
# Axumia Monorepo Root .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!.env.test

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Build & Compilation Artifacts
# ------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Database & ORM (Prisma)
# ------------------------------------------
/generated/prisma
**/generated/prisma/
generated/
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Logs, Diagnostic & Temporary Dumps
# ------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# One-off error, log, and diagnostic text dumps
*.log
**/*.log
*_logs.txt
**/*_logs.txt
*_logs_utf8.txt
**/*_logs_utf8.txt
*_error.txt
**/*_error.txt
*_errors.txt
**/*_errors.txt
*_errors_utf8.txt
**/*_errors_utf8.txt
*_errors_summary.txt
**/*_errors_summary.txt
*_err.txt
**/*_err.txt
*_err_utf8.txt
**/*_err_utf8.txt
*boot_logs.txt
**/*boot_logs.txt
ps.txt
**/ps.txt
dump_logs.js
**/dump_logs.js

# Scratch & Temporary Folders
tmp/
**/tmp/
temp/
**/temp/

# Backup & Swap Files
*.bak
*.backup
*.swp
*.swo
*.orig
*~

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# IDEs, Editors & AI Tools
# ------------------------------------------
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.windsurf/
**/.windsurf/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------
# Mobile / Flutter / Dart Platforms
# ------------------------------------------
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/ephemeral/
